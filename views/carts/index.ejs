<style>
  /* Flex container for cards */
  .container-flex {
    display: flex;
    flex-wrap: wrap; /* allows multiple rows */
    gap: 1rem; /* spacing between cards */
  }

  /* Card wrapper */
  .main-box {
    flex: 0 1 18%; /* roughly 5 cards per row */
    text-decoration: none;
  }

  /* Card image */
  .main-box img {
    width: 100%;
    height: 200px; /* fixed height */
    object-fit: cover; /* scale nicely */
    border-radius: 10px;
    border: 1px solid white;
  }

  /* Card body */
  .card-body {
    background-color: #bee3fa;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
  }

  .card-body h5 {
    margin: 0;
  }

  .card-body ul {
    padding-left: 1rem;
    margin: 0;
    font-size: 0.8rem;
  }

  /* Make cards responsive */
  @media (max-width: 1200px) {
    .main-box {
      flex: 0 1 23%; /* 4 cards per row */
    }
  }
  @media (max-width: 992px) {
    .main-box {
      flex: 0 1 31%; /* 3 cards per row */
    }
  }
  @media (max-width: 768px) {
    .main-box {
      flex: 0 1 48%; /* 2 cards per row */
    }
  }
  @media (max-width: 576px) {
    .main-box {
      flex: 0 1 100%; /* 1 card per row */
    }
  }
</style>

<% layout("./layout/boilerplate") %>

<h1>Your Cart Items</h1>

<div class="container-flex">
  <% if(cartItems.length === 0) { %>
  <p>Your cart is empty!</p>
  <% } else { %> <% cartItems.forEach(item => { %>
  <div class="card main-box">
    <img
      src="<%= item.product.imageUrl || 'https://plus.unsplash.com/premium_photo-1675252369719-dd52bc69c3df?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D' %>"
      alt="<%= item.product.name %>"
    />
    <div class="card-body">
      <h5 class="card-title"><%= item.product.name %></h5>
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item">Quantity = <%= item.quantity %></li>
      <li class="list-group-item">Price = <%= item.product.price %></li>
      <li class="list-group-item">
        Total = <%= item.product.price * item.quantity %>
      </li>
    </ul>
    <div class="card-body">
      <!-- Increase quantity -->
      <form
        action="/products/carts/<%= item.product._id %>/increase?_method=PUT"
        method="POST"
      >
        <button class="btn btn-secondary w-100 mb-1">Add one</button>
      </form>

      <!-- Decrease quantity if > 1 -->
      <% if(item.quantity > 1) { %>
      <form
        action="/products/carts/<%= item.product._id %>/decrease?_method=PUT"
        method="POST"
      >
        <button class="btn btn-primary w-100 mb-1">Remove one</button>
      </form>
      <% } %>

      <!-- Remove item -->
      <form
        action="/products/carts/<%= item.product._id %>/remove?_method=DELETE"
        method="POST"
      >
        <button class="btn btn-danger w-100">Remove item</button>
      </form>
    </div>
  </div>
  <% }) %> <% } %>
</div>
